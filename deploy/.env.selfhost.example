# Public application URLs
APP_URL=https://app.example.com
API_URL=https://api.example.com
MCP_URL=https://mcp.example.com

# Self-hosted Supabase (apply migrations 001 through 012 first)
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=CHANGE-ME
DATABASE_URL=postgresql://postgres:CHANGE-ME@database.example.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:CHANGE-ME@database.example.com:5432/postgres

# MinIO / S3. The endpoint must resolve both from containers and browsers.
MINIO_ROOT_USER=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME
AWS_ACCESS_KEY_ID=CHANGE-ME
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_REGION=us-east-1
S3_BUCKET=llmwiki-documents
S3_ENDPOINT_URL=https://s3.example.com

# Internal converter authentication
CONVERTER_SECRET=CHANGE-ME

# Optional extraction and operations settings
MISTRAL_API_KEY=
PDF_BACKEND=opendataloader
GLOBAL_MAX_USERS=10000
SENTRY_DSN=
STAGE=prod

# Opt-in values used only by tests/integration/test_scaled_compose.py.
# Never commit a real token. Set STAGE=test before bringing up the smoke stack.
SCALED_COMPOSE_TEST=0
SCALED_TEST_API_URL=http://127.0.0.1:8000
SCALED_TEST_DATABASE_URL=
SCALED_TEST_TOKEN=
SCALED_TEST_USER_ID=
